# https://editorconfig.org — keeps indentation consistent across editors so
# diffs stay about the code. Matches what's already in the tree.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.lua]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
# Recipe lines must start with a real tab.
indent_style = tab

[*.sh]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100
